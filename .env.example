# Local backend configuration
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres?sslmode=disable
PORT=8787

# Shared password between the Go backend and settlement executor.
# This is not a wallet key and is not sent to the blockchain.
SETTLEMENT_API_KEY=replace-with-a-long-random-local-secret

# Settlement contract on BSC
SETTLEMENT_CONTRACT=0x4896ebe3EE1436a58c690A8021301A6bFD6BD4E7

# Executor settings. Keep simulation mode until token approvals and wallet funding are ready.
SETTLEMENT_LIVE=false
BSC_RPC_URL=https://bsc-rpc.publicnode.com
SETTLEMENT_POLL_MS=3000
